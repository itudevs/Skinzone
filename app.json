{
  "expo": {
    "name": "Skinzone",
    "slug": "skinzone",
    "version": "2.0",
    "orientation": "portrait",
    "icon": "./assets/images/SkinzoneLogoSquare.png",
    "backgroundColor": "#FFFFFF",
    "scheme": "za.co.skinzone",
    "userInterfaceStyle": "automatic",
    "description": "A loyalty and visit tracking app for Skinzone beauty salon customers",
    "primaryColor": "#00C94F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.skinzone.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to let you choose a profile picture.",
        "NSCameraUsageDescription": "We need access to your camera to let you take a profile picture.",
        "NSLocationWhenInUseUsageDescription": "This app does not use your location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/SkinzoneLogoSquare.png",
        "backgroundImage": "./assets/images/SkinzoneLogoSquare.png",
        "monochromeImage": "./assets/images/SkinzoneLogoSquare.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.skinzone.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SkinzoneLogoSquare.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#191919"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/SkinzoneLogoSquare.png",
          "color": "#E6F4FE"
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5329a76-c532-4577-831d-815e46a2b8cd"
      }
    }
  }
}
