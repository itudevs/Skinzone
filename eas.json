{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
